# .env.example - Environment Variable Template
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.

# -- LLM Provider --------------------------------------------------------------
# Choose one provider. Set the matching API key below.
# Options: "gemini" | "openai" | "groq"
LLM_PROVIDER=gemini

# Google Gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL_NAME=gemini-3.6-flash

# -- Model Parameters ----------------------------------------------------------
# Keep temperature at 0.0 for deterministic, consistent outputs.
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# -- Application ----------------------------------------------------------------
APP_NAME="AI Resume & JD Matcher"

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:8000
